{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warble",
  "mainBinaryName": "warble",
  "version": "0.1.0",
  "identifier": "io.github.pieralukasz.warble",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Warble",
        "url": "index.html",
        "width": 880,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "pill",
        "title": "Warble pill",
        "url": "pill.html",
        "width": 230,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lucas Piera",
    "copyright": "MIT",
    "shortDescription": "Local push-to-talk dictation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
